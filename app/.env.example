# FastAPI Violence Detection System - Environment Configuration

# Model A (ST-GCN) Settings
MODEL_A_CHECKPOINT=/path/to/your/stgcn_checkpoint.pt
MODEL_A_POSE_WEIGHTS=yolov8n-pose.pt
MODEL_A_DEVICE=cpu
MODEL_A_SEQ_LEN=30
MODEL_A_STRIDE=15
MODEL_A_THRESHOLD=0.8

# Model B (MoViNet) Settings
MODEL_B_CHECKPOINT=/path/to/your/movinet_checkpoint.pt
MODEL_B_DEVICE=cpu
MODEL_B_CLIP_LENGTH=6
MODEL_B_THRESHOLD=0.47
MODEL_B_CLASS_NAMES=["no_violence", "violence"]

# Model C (R(2+1)D) Settings
MODEL_C_CHECKPOINT=./r2p1_vivit_mae/r2p1/best_r2p1d18.pt
MODEL_C_DEVICE=cpu
MODEL_C_CLIP_LENGTH=16
MODEL_C_THRESHOLD=0.5

# Model D (ViViT) Settings
MODEL_D_CHECKPOINT=./r2p1_vivit_mae/vivit/best_model
MODEL_D_DEVICE=cpu
MODEL_D_CLIP_LENGTH=32
MODEL_D_THRESHOLD=0.5
MODEL_D_POSITIVE_LABEL=Fight

# Model E (VideoMAE) Settings
MODEL_E_CHECKPOINT=./r2p1_vivit_mae/mae/best_model
MODEL_E_DEVICE=cpu
MODEL_E_CLIP_LENGTH=16
MODEL_E_THRESHOLD=0.5
MODEL_E_POSITIVE_LABEL=Fight

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=*
